{
  "name": "@ft/backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "1.7.0-rc.6",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "hono-rate-limiter": "^0.5.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./app": {
      "types": "./dist/routes/internal.d.ts",
      "import": "./dist/routes/internal.js"
    },
    "./client": {
      "types": "./dist/rpc-client.d.ts",
      "import": "./dist/rpc-client.js"
    }
  }
